{
  "appId": "com.roverostech.rover",
  "appName": "RoverOS",
  "webDir": "dist/public",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "Geolocation": {
      "permissions": [
        "location",
        "coarseLocation"
      ]
    },
    "Camera": {
      "permissions": [
        "camera"
      ]
    },
    "Haptics": {}
  }
}
