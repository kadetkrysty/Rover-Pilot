[Unit]
Description=Install a verified RoverOS server update
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/var/lib/roveros-provisioner/complete

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/roveros-provisioner/environment
ExecStart=/usr/local/lib/roveros-provisioner/update-release.sh
TimeoutStartSec=infinity
