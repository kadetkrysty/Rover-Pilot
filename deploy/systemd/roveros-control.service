[Unit]
Description=RoverOS private Arduino motor-control bridge
After=local-fs.target
Before=roveros.service
Conflicts=rover_controller.service

[Service]
Type=simple
User=roveros
Group=roveros
SupplementaryGroups=dialout
WorkingDirectory=/opt/roveros/current/firmware/mini_pc_master
EnvironmentFile=-/etc/roveros/hardware.env
ExecStart=/usr/bin/python3 -B /opt/roveros/current/firmware/mini_pc_master/secure_control_daemon.py
Restart=on-failure
RestartSec=2
RuntimeDirectory=roveros-control
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
TimeoutStopSec=2

[Install]
WantedBy=multi-user.target
