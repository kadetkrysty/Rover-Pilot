{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "desktop:win": "electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node --test desktop/server-url.test.cjs desktop/build-config.test.cjs desktop/secure-api-request.test.cjs scripts/normalize-github-npm-lock.test.mjs",
    "test:client-connection": "node --import tsx --test client/src/lib/roverConnection.test.ts client/src/lib/discoveredServer.test.ts client/src/lib/demoMode.test.ts",
    "test:client-auth": "node --import tsx --test server/clientAuth.test.ts server/routes.auth.test.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/minipc/migrate.cjs",
    "package:server": "node scripts/minipc/package-release.mjs",
    "test:provisioning": "node --test scripts/minipc/*.test.cjs desktop/provisioning-request.test.cjs",
    "test:server-bundle": "node scripts/minipc/test-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/camera": "8.2.6",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/haptics": "8.0.2",
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
