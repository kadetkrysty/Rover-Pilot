    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.60.5",
    "@types/google.maps": "^3.58.1",
    "@types/three": "^0.182.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "framer-motion": "^12.23.24",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "lucide-react": "^0.545.0",
    "memorystore": "^1.6.7",
    "next-themes": "^0.4.6",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "polyline": "^0.2.0",
    "postgres": "^3.4.7",
    "react": "^19.3.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.66.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "^0.4.4",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.19.0",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.7"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "fflate": "^0.8.3",
    "glob": "^14.0.3",
    "lodash": "^4.18.1",
    "picomatch": "^4.0.7",
    "proxy-addr": "^2.0.8",
    "rimraf": "^6.1.4",
    "rollup": "^4.67.4",
    "three-stdlib": {
      "fflate": "^0.6.11"
    }
  },
  "build": {
    "forceCodeSigning": true,
    "appId": "com.roverostech.rover.desktop",
    "productName": "RoverOS",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/server-url.cjs",
      "desktop/provisioning-request.cjs",
      "desktop/secure-api-request.cjs",
      "desktop/setup.html",
      "desktop/setup.css",
      "desktop/setup.js",
      "desktop/assets/roveros.svg",
      "desktop/assets/roveros.ico",
      "dist/public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/roveros.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "RoverOS-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RoverOS"
    }
  }
}
